# 复制为 .env 后使用：cp .env.example .env
# 这些是本地开发用凭据，不要提交真实密钥

MYSQL_ROOT_PASSWORD=change-me
RABBITMQ_USERNAME=logiflow
RABBITMQ_PASSWORD=change-me
# JJWT 要求密钥至少 32 字节，可用 `openssl rand -base64 48` 生成
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# AI 服务密钥（当前为 DeepSeek），从服务商控制台获取；留空则 AI 接口不可用，不影响其他功能
AI_API_KEY=change-me
# 以下两项可选，不设置时使用 application.yml / docker-compose.yml 中的默认值
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-flash
